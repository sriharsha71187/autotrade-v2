<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.autotrade.cycle</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/nirvaan/autotrade/venv/bin/python3</string>
        <string>/Users/nirvaan/autotrade/autotrade.py</string>
        <string>cycle</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <!-- log() already writes every line to ~/autotrade.log; redirecting stdout
         there too doubles every line under launchd. Discard stdout, keep stderr. -->
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/Users/nirvaan/autotrade_error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
