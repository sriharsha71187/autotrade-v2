<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.autotrade.cycle</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/autotrade/venv/bin/python3</string>
        <string>__HOME__/autotrade/autotrade.py</string>
        <string>cycle</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/autotrade.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/autotrade_error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
