# =============================================================================
# YouTube Channel Manager — configuration
# Copy to ~/.youtube_channel.env (kept OUTSIDE the repo) and fill in.
# Load order: process env  ->  ~/.youtube_channel.env  ->  ./.env
# =============================================================================

# ---- Channel identity -------------------------------------------------------
# A niche-agnostic theme. Change this and the whole channel re-themes itself.
# Examples: "60-second explainers about space", "daily stock market recap",
#           "calm productivity tips", "weird history facts".
CHANNEL_THEME=fascinating science facts explained simply
CHANNEL_NAME=Daily Curiosity
# Target spoken length of each video, in seconds.
VIDEO_TARGET_SECONDS=60
# Video resolution (vertical Shorts: 1080x1920, landscape: 1920x1080)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# ---- Script generation (Anthropic) ------------------------------------------
ANTHROPIC_API_KEY=
# Model used to write scripts / titles / descriptions.
SCRIPT_MODEL=claude-sonnet-4-6

# ---- Voiceover --------------------------------------------------------------
# Backend: gtts (free, default) | elevenlabs | openai
TTS_BACKEND=gtts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
OPENAI_TTS_VOICE=alloy

# ---- Visuals ----------------------------------------------------------------
# Backend: slides (free, default — captioned gradient slides) | openai (DALL·E)
VISUALS_BACKEND=slides

# ---- YouTube upload ---------------------------------------------------------
# OAuth client secrets JSON (download from Google Cloud Console).
# Path to the client_secret.json file:
YOUTUBE_CLIENT_SECRETS=~/.youtube_channel_client_secret.json
# Where the refresh token is cached after the first browser auth:
YOUTUBE_TOKEN_FILE=~/.youtube_channel_token.json
# unlisted | private | public
YOUTUBE_PRIVACY=unlisted
# Set to 1 to actually upload; 0 = build the video but skip upload (dry run).
YOUTUBE_UPLOAD=0

# ---- Output -----------------------------------------------------------------
# Directory for rendered videos and run state.
OUTPUT_DIR=~/youtube_channel_output
